{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": ["style", "spec_version", "title", "prompts", "close"],
 "properties": {
  "style": {"const": "prompt-pack"},
  "spec_version": {"const": 1},
  "passage": {"type": "string"},
  "format": {"type": "object"},
  "number": {"type": "string", "pattern": "^[0-9]{2}$"},
  "title": {"type": "string", "minLength": 3, "maxLength": 60},
  "title_italic": {"type": "string"},
  "cover": {
   "type": "object",
   "properties": {"rings_until": {}, "lines_until": {}},
   "additionalProperties": false
  },
  "prompts": {
   "type": "array",
   "minItems": 1,
   "maxItems": 5,
   "items": {
    "type": "object",
    "required": ["heading", "text"],
    "properties": {
     "heading": {"type": "string", "minLength": 2, "maxLength": 24},
     "heading_italic": {"type": "string"},
     "sub": {"type": "string", "maxLength": 70},
     "tool": {"type": "string", "maxLength": 24},
     "text": {"type": "string", "minLength": 10, "maxLength": 460},
     "mark": {"type": "string", "maxLength": 50},
     "tip_label": {"enum": ["THEN", "MINE", "TRY", "TIP"]},
     "tip": {"type": "string", "maxLength": 70}
    },
    "additionalProperties": false
   }
  },
  "close": {
   "type": "object",
   "required": ["line", "cta"],
   "properties": {
    "kicker": {"type": "string", "maxLength": 40},
    "line": {"type": "string", "minLength": 3, "maxLength": 70},
    "italic": {"type": "string"},
    "cta": {"type": "string", "maxLength": 40}
   },
   "additionalProperties": false
  },
  "beats": {"type": "array", "maxItems": 0},
  "sound": {"type": "object"},
  "brand": {"type": "object"}
 },
 "additionalProperties": false
}
