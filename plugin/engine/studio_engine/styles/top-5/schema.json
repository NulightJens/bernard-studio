{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$defs": {
  "picture": {
   "type": "object",
   "required": ["source"],
   "properties": {
    "source": {"type": "string", "minLength": 1},
    "t": {"type": "number", "minimum": 0},
    "from": {"type": "number", "minimum": 0},
    "to": {"type": "number", "minimum": 0},
    "zoom": {"type": "number", "minimum": 1, "maximum": 3},
    "x": {"type": "number", "minimum": 0, "maximum": 1},
    "y": {"type": "number", "minimum": 0, "maximum": 1}
   },
   "additionalProperties": false
  }
 },
 "type": "object",
 "required": ["style", "spec_version", "cover", "items"],
 "properties": {
  "style": {"const": "top-5"},
  "spec_version": {"const": 1},
  "passage": {"type": "string"},
  "format": {"type": "object"},
  "cover": {
   "type": "object",
   "required": ["title", "photo"],
   "properties": {
    "title": {"type": "string", "minLength": 3, "maxLength": 50},
    "kicker": {"type": "string", "maxLength": 40},
    "photo": {"$ref": "#/$defs/picture"}
   },
   "additionalProperties": false
  },
  "items": {
   "type": "array",
   "minItems": 3,
   "maxItems": 10,
   "items": {
    "type": "object",
    "required": ["title", "photo", "quote"],
    "properties": {
     "title": {"type": "string", "minLength": 2, "maxLength": 40},
     "small": {"type": "string", "maxLength": 40},
     "photo": {"$ref": "#/$defs/picture"},
     "from": {"type": "string", "maxLength": 50},
     "quote": {"type": "string", "minLength": 3, "maxLength": 110}
    },
    "additionalProperties": false
   }
  },
  "beats": {"type": "array", "maxItems": 0},
  "sound": {"type": "object"},
  "brand": {"type": "object"}
 },
 "additionalProperties": false
}
