{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": ["style", "spec_version", "beats"],
 "$defs": {
  "at": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "number"},
                   {"type": "object", "properties": {"word": {"type": "integer", "minimum": 0}, "t": {"type": "number"},
                    "edge": {"enum": ["start", "end", "mid"]}, "offset": {"type": "number"}}, "additionalProperties": false}]},
  "side": {"enum": ["left", "right", "centre"]},
  "crop": {"type": "object",
           "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1},
                          "y": {"type": "number", "minimum": 0, "maximum": 1},
                          "w": {"type": "number", "minimum": 0.1, "maximum": 1}},
           "additionalProperties": false},
  "picture": {"type": "object", "required": ["source"],
              "properties": {"source": {"type": "string", "minLength": 1}, "in": {"type": "number", "minimum": 0},
                             "crop": {"$ref": "#/$defs/crop"}},
              "additionalProperties": false},
  "beat": {
   "type": "object",
   "required": ["kind", "at"],
   "properties": {
    "kind": {"enum": ["picture", "figure", "room"]},
    "at": {"$ref": "#/$defs/at"},
    "side": {"$ref": "#/$defs/side"},
    "source": {"type": "string", "minLength": 1},
    "in": {"type": "number", "minimum": 0},
    "crop": {"$ref": "#/$defs/crop"},
    "keep_figure": {"type": "boolean"},
    "text": {"type": "string", "minLength": 1, "maxLength": 9},
    "unit": {"type": "string", "minLength": 1, "maxLength": 10},
    "old": {"type": "string", "minLength": 1, "maxLength": 9},
    "size": {"type": "number", "minimum": 0.6, "maximum": 1.5},
    "red": {"type": "boolean"},
    "label": {"type": "array", "maxItems": 3,
              "items": {"type": "object", "required": ["text", "at"],
                        "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 18},
                                       "at": {"$ref": "#/$defs/at"}},
                        "additionalProperties": false}}
   },
   "allOf": [
    {"if": {"properties": {"kind": {"const": "picture"}}}, "then": {"required": ["source"]}},
    {"if": {"properties": {"kind": {"const": "figure"}}}, "then": {"required": ["text"]}}
   ],
   "additionalProperties": false
  }
 },
 "properties": {
  "style": {"const": "cutout"},
  "spec_version": {"const": 1},
  "passage": {"type": "string"},
  "format": {"type": "object"},
  "sources": {"type": "object", "additionalProperties": {"type": "string"}},
  "cutout": {
   "type": "object",
   "properties": {
    "x": {"type": "number", "minimum": 0, "maximum": 1},
    "width": {"type": "number", "minimum": 0.3, "maximum": 1},
    "scale": {"type": "number", "minimum": 0.5, "maximum": 1.3},
    "band": {"type": "integer", "minimum": 0, "maximum": 61},
    "brighten": {"type": "number", "minimum": 1, "maximum": 1.4}
   },
   "additionalProperties": false
  },
  "opening": {
   "type": "object",
   "properties": {
    "kicker": {"anyOf": [{"type": "boolean"}, {"type": "integer", "minimum": 1, "maximum": 99}]},
    "figure": {"type": "string", "maxLength": 12},
    "trail": {"type": "string", "maxLength": 28},
    "scale": {"type": "number", "minimum": 0.6, "maximum": 1.4},
    "side": {"$ref": "#/$defs/side"},
    "picture": {"$ref": "#/$defs/picture"}
   },
   "additionalProperties": false
  },
  "beats": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/beat"}},
  "room": {
   "type": "object",
   "properties": {
    "x": {"type": "number", "minimum": 0, "maximum": 1},
    "zoom": {"type": "number", "minimum": 1, "maximum": 3},
    "top": {"type": "integer", "minimum": 0, "maximum": 900}
   },
   "additionalProperties": false
  },
  "captions": {
   "type": "array", "maxItems": 40,
   "items": {"type": "object", "required": ["at", "text"],
             "properties": {"at": {"$ref": "#/$defs/at"}, "until": {"$ref": "#/$defs/at"},
                            "text": {"type": "string", "minLength": 1, "maxLength": 28},
                            "red": {"type": "string", "minLength": 1, "maxLength": 16}},
             "additionalProperties": false}
  },
  "tail": {"type": "number", "minimum": 0, "maximum": 2},
  "effects": {"anyOf": [{"type": "boolean"}, {"type": "object", "properties": {
    "softer_db": {"type": "number", "minimum": 0, "maximum": 6}}, "additionalProperties": false}]},
  "finish": {"type": "object", "properties": {"grain": {"type": "number", "minimum": 0, "maximum": 0.08}},
             "additionalProperties": false},
  "sound": {"type": "object"},
  "brand": {"type": "object"}
 },
 "additionalProperties": false
}
