{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": ["style", "spec_version", "screens", "beats"],
 "$defs": {
  "at": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "number"},
                   {"type": "object", "properties": {"word": {"type": "integer", "minimum": 0}, "t": {"type": "number"},
                    "edge": {"enum": ["start", "end", "mid"]}, "offset": {"type": "number"}}, "additionalProperties": false}]},
  "text": {"type": "string", "minLength": 1, "maxLength": 24}
 },
 "properties": {
  "style": {"const": "screen-and-face"},
  "spec_version": {"const": 1},
  "passage": {"type": "string"},
  "format": {"type": "object"},
  "sources": {"type": "object", "additionalProperties": {"type": "string"}},
  "face": {
   "type": "object",
   "properties": {
    "x": {"type": "number", "minimum": 0, "maximum": 1},
    "y": {"type": "number", "minimum": 0, "maximum": 1},
    "zoom": {"type": "number", "minimum": 1, "maximum": 3}
   },
   "additionalProperties": false
  },
  "screens": {
   "type": "array", "minItems": 1, "maxItems": 12,
   "items": {
    "type": "object",
    "properties": {
     "source": {"type": "string"},
     "from": {"$ref": "#/$defs/at"},
     "in": {"type": "number", "minimum": 0},
     "out": {"type": "number", "minimum": 0},
     "speed": {"type": "number", "minimum": 0.25, "maximum": 4},
     "push": {"type": "array", "items": {"type": "number", "minimum": 0.8, "maximum": 1.6}, "minItems": 2, "maxItems": 2},
     "origin": {"type": "string", "pattern": "^\\d{1,3}% \\d{1,3}%$"}
    },
    "additionalProperties": false
   }
  },
  "beats": {
   "type": "array", "minItems": 1, "maxItems": 6,
   "items": {
    "type": "object",
    "required": ["kind", "at", "text"],
    "properties": {
     "kind": {"const": "figure"},
     "at": {"$ref": "#/$defs/at"},
     "text": {"type": "string", "minLength": 1, "maxLength": 9},
     "scale": {"type": "number", "minimum": 0.7, "maximum": 1.4},
     "lines": {
      "type": "array", "maxItems": 2,
      "items": {"type": "object", "required": ["text"],
                "properties": {"text": {"$ref": "#/$defs/text"}, "at": {"$ref": "#/$defs/at"}},
                "additionalProperties": false}
     },
     "rule": {"$ref": "#/$defs/at"},
     "strike": {"$ref": "#/$defs/at"},
     "underline": {"$ref": "#/$defs/at"},
     "until": {"$ref": "#/$defs/at"}
    },
    "additionalProperties": false
   }
  },
  "join_sound": {"anyOf": [{"const": false}, {"type": "object", "properties": {
    "name": {"type": "string"}, "under_db": {"type": "number", "minimum": 24, "maximum": 30},
    "len": {"type": "number"}, "offset": {"type": "number"}}, "additionalProperties": false}]},
  "finish": {"type": "object", "properties": {"grain": {"type": "integer", "minimum": 0, "maximum": 20}},
             "additionalProperties": false},
  "sound": {"type": "object"},
  "brand": {"type": "object"}
 },
 "additionalProperties": false
}
