{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": ["style", "spec_version", "posts", "back", "zoom", "lift"],
 "$defs": {
  "at": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "number"},
                   {"type": "object", "properties": {"word": {"type": "integer", "minimum": 0}, "t": {"type": "number"},
                    "edge": {"enum": ["start", "end", "mid"]}, "offset": {"type": "number"}}, "additionalProperties": false}]},
  "frac4": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 4, "maxItems": 4},
  "post": {
   "type": "object",
   "required": ["source"],
   "properties": {
    "source": {"type": "string", "minLength": 1},
    "at": {"type": "number", "minimum": 0},
    "point": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2},
    "picture": {"$ref": "#/$defs/frac4"},
    "crop_y": {"type": "number", "minimum": 0, "maximum": 1}
   },
   "additionalProperties": false
  }
 },
 "properties": {
  "style": {"const": "your-feed"},
  "spec_version": {"const": 1},
  "passage": {"type": "string"},
  "format": {"type": "object"},
  "sources": {"type": "object", "additionalProperties": {"type": "string"}},
  "lead": {"type": "number", "minimum": 0, "maximum": 1.5},
  "tail": {"type": "number", "minimum": 0.5, "maximum": 3},
  "posts": {
   "type": "object",
   "required": ["first", "second"],
   "properties": {"first": {"$ref": "#/$defs/post"}, "second": {"$ref": "#/$defs/post"}},
   "additionalProperties": false
  },
  "scroll": {
   "type": "object",
   "properties": {"at": {"$ref": "#/$defs/at"}, "land": {"$ref": "#/$defs/at"}, "click": {"$ref": "#/$defs/at"}},
   "additionalProperties": false
  },
  "back": {
   "type": "object",
   "required": ["at"],
   "properties": {
    "at": {"$ref": "#/$defs/at"}, "label": {"$ref": "#/$defs/at"}, "above": {"$ref": "#/$defs/at"},
    "below": {"$ref": "#/$defs/at"}, "same": {"$ref": "#/$defs/at"},
    "caption": {"type": "object", "required": ["text", "at"],
                "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 22}, "at": {"$ref": "#/$defs/at"}},
                "additionalProperties": false}
   },
   "additionalProperties": false
  },
  "zoom": {
   "type": "object",
   "required": ["at"],
   "properties": {
    "at": {"$ref": "#/$defs/at"},
    "focus": {"type": "object", "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1},
              "y": {"type": "number", "minimum": 0, "maximum": 1}, "scale": {"type": "number", "minimum": 0.8, "maximum": 3.5}},
              "additionalProperties": false},
    "title": {"type": "object", "properties": {"small": {"type": "string", "maxLength": 24}, "big": {"type": "string", "maxLength": 18}},
              "additionalProperties": false},
    "frame": {"type": "object", "required": ["box", "at"], "properties": {"box": {"$ref": "#/$defs/frac4"}, "at": {"$ref": "#/$defs/at"}},
              "additionalProperties": false}
   },
   "additionalProperties": false
  },
  "lift": {
   "type": "object",
   "required": ["at", "pull"],
   "properties": {"at": {"$ref": "#/$defs/at"}, "pull": {"$ref": "#/$defs/at"}, "red": {"$ref": "#/$defs/at"},
                  "rule_y": {"type": "number", "minimum": 0, "maximum": 0.95}},
   "additionalProperties": false
  },
  "sound": {
   "type": "object",
   "properties": {"bed": {"type": "string"}, "under_db": {"type": "number", "minimum": 14, "maximum": 26},
                  "effects": {"type": "boolean"}},
   "additionalProperties": false
  },
  "finish": {"type": "object", "properties": {"grain": {"type": "number", "minimum": 0, "maximum": 0.2}},
             "additionalProperties": false}
 },
 "additionalProperties": false
}
