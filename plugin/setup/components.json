{
  "schema": 1,
  "components": {
    "homebrew": {
      "name": "Homebrew",
      "what": "the standard free installer for Mac tools. A Terminal window opens and you type your Mac password once.",
      "needs": [],
      "disk_gb": 2,
      "password": true
    },
    "base": {
      "name": "Base tools",
      "what": "video tools, speech-to-text with its model, the Python environment, and your Bernard Studio folder. Every style needs these.",
      "needs": ["homebrew"],
      "disk_gb": 5
    },
    "slides": {
      "name": "Slide maker",
      "what": "a hidden browser that turns slide designs into images",
      "needs": ["base"],
      "disk_gb": 1
    },
    "remotion": {
      "name": "Motion graphics",
      "what": "Node and Remotion, which draw the moving parts, plus the browser they render with",
      "needs": ["base"],
      "disk_gb": 2
    },
    "matte": {
      "name": "Cutout model",
      "what": "the model that cuts you out of the background, plus the model that lines words up with your voice",
      "needs": ["base"],
      "disk_gb": 6,
      "mac": { "apple_silicon": true, "memory_gb": 16 }
    },
    "blender": {
      "name": "Blender",
      "what": "the free 3D app, only needed to make new object pictures",
      "needs": ["homebrew"],
      "disk_gb": 3,
      "on_demand": true,
      "mac": { "apple_silicon": true, "memory_gb": 16 }
    },
    "links": {
      "name": "Link downloader",
      "what": "downloads your own posts from YouTube or TikTok links",
      "needs": ["homebrew"],
      "disk_gb": 1,
      "on_demand": true
    },
    "auphonic": {
      "name": "Auphonic key",
      "what": "optional: cleaner voice through your own Auphonic account. The key is kept in your Mac's Keychain.",
      "needs": [],
      "disk_gb": 0,
      "on_demand": true,
      "optional": true
    }
  },
  "styles": {
    "screen-and-face":   { "needs": ["base", "remotion"] },
    "receipts":          { "needs": ["base"] },
    "documentary":       { "needs": ["base"] },
    "words-in-the-room": { "needs": ["base", "remotion", "matte"] },
    "cutout":            { "needs": ["base", "matte"] },
    "the-art-of":        { "needs": ["base", "slides"], "optional": { "matte": "only to make new poses from your footage", "blender": "only to make new objects" } },
    "prompt-pack":       { "needs": ["base", "slides"] },
    "field-notes":       { "needs": ["base", "slides"] },
    "top-5":             { "needs": ["base", "slides"] },
    "zen-garden":        { "needs": ["base"] },
    "your-feed":         { "needs": ["base", "remotion"] },
    "moving-type":       { "needs": ["base"] }
  },
